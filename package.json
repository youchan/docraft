{
  "name": "docraft",
  "version": "0.1.0",
  "description": "Fully offline Markdown editor with live preview",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
